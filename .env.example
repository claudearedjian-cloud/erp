# WoodTek ERP — production environment
# Copy this file to  .env  (in the app folder, next to start-woodtek-prod.bat)
# and fill in real values.

# PostgreSQL connection — the app's database user (NOT the postgres superuser).
DATABASE_URL=postgres://woodtek_owner:1234@127.0.0.1:5432/woodtek_factory

# Session signing secret — REQUIRED for production.
# Generate one with:   powershell -ExecutionPolicy Bypass -File ops\set-auth-secret.ps1
AUTH_SECRET=

# Optional tuning
DB_CONNECT_TIMEOUT_MS=5000
DB_POOL_MAX=10

# Plain-HTTP LAN: keep the session cookie non-secure so logins work over http://
AUTH_COOKIE_SECURE=false

# NEVER turn this on for a real database — it wipes and reseeds demo data.
NEXT_PUBLIC_WOODTEK_DEMO=off
